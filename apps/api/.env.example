# Server
PORT=3001
FRONTEND_URL=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=agam_plus

# Google OAuth (verifies Google ID tokens at login; app data lives in MongoDB)
GOOGLE_CLIENT_ID=

# Auth
JWT_SECRET=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
HOSPITAL_NAME=Your Hospital Name

# Used in email templates (doctor welcome/approval links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp (Meta Cloud API). One Meta App serves every hospital, but each
# hospital connects its own WhatsApp Business Account in Settings — those
# credentials live (encrypted) in MongoDB, not here.
WHATSAPP_API_VERSION=v21.0
# Meta App secret — verifies the X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_APP_SECRET=
# Any random string; must match what you enter in the Meta webhook config.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Encrypts each hospital's stored access token. 64-char hex
# (openssl rand -hex 32) or a passphrase. Losing this makes every hospital's
# stored token unreadable — they would all have to reconnect.
WHATSAPP_TOKEN_ENCRYPTION_KEY=
# Optional: point the Graph client at a mock server for local testing.
# WHATSAPP_GRAPH_BASE_URL=http://localhost:4000


